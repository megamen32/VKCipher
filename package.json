{
  "name": "vkencrypt",
  "version": "5.6.0",
  "description": "Шифрует сообщения в ВКонтакте. Установка — 5 секунд.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamen32/VKCipher.git"
  },
  "homepage": "https://github.com/megamen32/VKCipher#readme",
  "bugs": {
    "url": "https://github.com/megamen32/VKCipher/issues"
  },
  "scripts": {
    "arena": "node arena/run.js",
    "arena:inspect": "node arena/inspect.js",
    "dictionary:build": "node arena/build-word-dictionary.js",
    "build": "bash extension/build.sh",
    "build:chrome": "npm run build && node scripts/build-chrome.mjs",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "build:safari-source": "npm run build && node scripts/build-safari-source.mjs",
    "build:safari": "bash scripts/build-safari.sh",
    "test:chrome-package": "node --test tests/chrome-package.test.mjs",
    "test:firefox-safari-package": "node --test tests/firefox-safari-package.test.mjs",
    "test": "playwright test",
    "test:middleware": "node --test tests/vk-middleware.test.mjs",
    "test:dictionary": "node --test tests/dictionary-orchestrator.test.js",
    "test:arena": "playwright test tests/playwright/adversarial-arena.spec.js",
    "test:headed": "playwright test --headed",
    "test:live": "RUN_LIVE=1 playwright test --config=playwright.live.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
