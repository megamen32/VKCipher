{
  "name": "vkencrypt",
  "version": "5.4.0",
  "description": "Шифрует сообщения в ВКонтакте. Установка — 5 секунд.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamen32/vkencrypt.git"
  },
  "homepage": "https://github.com/megamen32/vkencrypt#readme",
  "bugs": {
    "url": "https://github.com/megamen32/vkencrypt/issues"
  },
  "scripts": {
    "arena": "node arena/run.js",
    "arena:inspect": "node arena/inspect.js",
    "dictionary:build": "node arena/build-word-dictionary.js",
    "build": "bash extension/build.sh",
    "test": "playwright test",
    "test:middleware": "node --test tests/vk-middleware.test.mjs",
    "test:dictionary": "node --test tests/dictionary-orchestrator.test.js",
    "test:arena": "playwright test tests/playwright/adversarial-arena.spec.js",
    "test:headed": "playwright test --headed",
    "test:live": "RUN_LIVE=1 playwright test --config=playwright.live.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
